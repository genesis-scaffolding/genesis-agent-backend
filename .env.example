# Copy this file to `.env` and fill in your paths. `.env` is gitignored.
#
# Path to your local models directory. Should contain the standard layouts:
#   <MODELS_ROOT>/huggingface/hub/      (HF cache with models--org--name dirs)
#   <MODELS_ROOT>/lmstudio/models/      (LM Studio layout, publisher/<model-dir>)
# catalog.py walks both.
MODELS_ROOT=/home/you/models