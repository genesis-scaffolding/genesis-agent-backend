#!/usr/bin/env bash
# bin/bonsai-server — run llama-server directly for the Bonsai 27B model.
#
# Mirrors `config.yaml` (the entry llama-swap uses), but without llama-swap in
# the way. Useful when you want to:
#   - push --ctx-size all the way to 262k and see what actually fits,
#   - turn the dspark drafter off to free VRAM for KV cache,
#   - try different KV cache quantisations,
#   - inspect llama-server's startup log without llama-swap wrapping it.
#
# All settings below default to the same values llama-swap uses. Override
# with env vars or by appending extra args after `--`:
#
#   PORT=9095 CTX=4096 ./bin/bonsai-server
#   CTX=262144 KV_TYPE=q4_0 NO_DRAFT=1 ./bin/bonsai-server
#   ./bin/bonsai-server -- --no-warmup --batch-size 1024
#
# Important — read the README first:
#   * --parallel > 1 silently falls layers back to CPU (~10× slower). Stay at 1.
#   * The dspark drafter was trained with 4096 ctx; longer ctx drops its
#     acceptance rate and erodes the speedup. Lower CTX = better draft hits.
#   * KV_TYPE=q4_0 is the only way large ctx fits on a 16 GB GPU.
set -euo pipefail

LLAMA=/home/gentran1991/Documents/GitHub/my-agent-backend/vendor/prism-llama.cpp/build/bin/llama-server
SNAP=/home/gentran1991/Data2/models/huggingface/hub/models--prism-ml--Ternary-Bonsai-27B-gguf/snapshots/20e435f518bd5b882795954aba81e80a91894321

# ---- defaults (match config.yaml) ----
CTX="${CTX:-8192}"
PORT="${PORT:-8080}"
PARALLEL="${PARALLEL:-1}"
KV_TYPE="${KV_TYPE:-f16}" # f16 = matches config.yaml. Set q4_0 to enable 100k+ ctx.
HOST="${HOST:-127.0.0.1}"
NGL="${NGL:-99}"
EXTRA_ARGS=()

for arg in "$@"; do
  if [[ "$arg" == "--" ]]; then
    shift
    EXTRA_ARGS+=("$@")
    break
  fi
done

# Refuse to run if our port is already taken (helps catch "did I forget to kill the last one")
if command -v ss >/dev/null && ss -ltn 2>/dev/null | grep -qE "[:.]${PORT}\b"; then
  echo "port ${PORT} is already bound. Either kill the other process or set PORT=..." >&2
  exit 1
fi

MODEL="$SNAP/Ternary-Bonsai-27B-Q2_0.gguf"
DRAFT="$SNAP/Ternary-Bonsai-27B-dspark-Q4_1.gguf"
MMPROJ="$SNAP/Ternary-Bonsai-27B-mmproj-Q8_0.gguf"

args=(
  --model "$MODEL"
  -c "$CTX"
  -ctk "$KV_TYPE" -ctv "$KV_TYPE"
  --port "$PORT"
  --host "$HOST"
  --parallel "$PARALLEL"
  -ngl "$NGL"
  --jinja
  --temp 0.7 --top-p 0.95 --top-k 20
  -fa on
)

if [[ -z "${NO_DRAFT:-}" ]]; then
  args+=(
    --model-draft "$DRAFT"
    --spec-type draft-dspark
    --spec-draft-n-max 4
    --spec-draft-n-min 4
    --gpu-layers-draft 99
  )
fi

if [[ -z "${NO_MMPROJ:-}" ]]; then
  args+=(--mmproj "$MMPROJ")
fi

args+=("${EXTRA_ARGS[@]}")

echo "=== Bonsai 27B (Q2_0) — direct llama-server ==="
echo "  binary:    $LLAMA"
echo "  model:     $MODEL"
echo "  draft:     ${NO_DRAFT:-dspark-Q4_1}"
echo "  vision:    ${NO_MMPROJ:-mmproj-Q8_0}"
echo "  ctx:       $CTX"
echo "  port:      $PORT  →  http://${HOST}:${PORT}/v1/"
echo "  parallel:  $PARALLEL   (do NOT raise without reading README)"
echo "  kv cache:  $KV_TYPE (per token K + V)"
echo "  gpu ngl:   $NGL"
echo
echo "  quick test:"
echo "    curl http://${HOST}:${PORT}/v1/models"
echo "    curl http://${HOST}:${PORT}/v1/chat/completions \\"
echo "      -H 'Content-Type: application/json' \\"
echo "      -d '{\"model\":\"Ternary-Bonsai-27B-Q2_0.gguf\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":40}'"
echo

exec "$LLAMA" "${args[@]}"
